# Local gateway development environment variables

# Required for management endpoints
OTARI_MASTER_KEY=replace-with-a-secure-random-value

# Optional overrides
# OTARI_DATABASE_URL=postgresql://gateway:gateway@localhost:5432/gateway
OTARI_HOST=0.0.0.0
OTARI_PORT=8000
OTARI_AUTO_MIGRATE=true
OTARI_BOOTSTRAP_API_KEY=true

# Provider credentials used directly by gateway/provider clients
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
MISTRAL_API_KEY=
GEMINI_API_KEY=

# Web-search backend (optional), one of two ways. A licensed API the gateway
# calls itself, which needs no extra container:
# OTARI_WEB_SEARCH_PROVIDER=tavily
# OTARI_WEB_SEARCH_PROVIDER_API_KEY=
# Or any service exposing a SearXNG-compatible /search?format=json endpoint,
# such as the bundled `web-search` compose profile:
# OTARI_WEB_SEARCH_URL=http://searxng:8080
