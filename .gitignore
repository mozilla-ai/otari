.DS_Store

.idea/

# Stray node_modules from running npx at the repo root (web has its own)
node_modules/

# Built dashboard bundle (`make dashboard`). Deliberately not committed: Vite
# content-hashes every asset filename, so any change under web/src renamed the
# whole directory and rewrote index.html, which made rebases and merges conflict
# by construction. The Docker image builds it in a Node stage instead; a source
# checkout that has not built it degrades to the tutorial page.
/src/gateway/static/dashboard/
# pnpm's content-addressable store. pnpm falls back to a repo-relative
# .pnpm-store when it cannot use a store on the same filesystem as the install
# target, which is what happens in a container, so an install at the repo root
# leaves tens of thousands of files here. web/node_modules hard-links into it,
# so it stays on disk and is only untracked. Deliberately unanchored: an install
# run from web/ leaves the same store one level down.
.pnpm-store/
