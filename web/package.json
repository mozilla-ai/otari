{
  "name": "@mozilla-ai/otari-dashboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "description": "Otari admin web dashboard (React + HeroUI v3). Builds into src/gateway/static/dashboard so the gateway can serve it.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "pnpm run client:generate && vitest run",
    "test:watch": "vitest",
    "e2e": "pnpm run build && playwright test --project=onboarding --project=seed --project=parity",
    "e2e:screenshots": "pnpm run build && playwright test --project=screenshots-desktop-large-light --project=screenshots-desktop-large-dark --project=screenshots-desktop-small-light --project=screenshots-desktop-small-dark --project=screenshots-mobile-light --project=screenshots-mobile-dark",
    "e2e:screenshots:update": "pnpm run e2e:screenshots --update-snapshots=changed",
    "e2e:install": "playwright install chromium",
    "client:generate": "openapi-typescript ../docs/public/openapi.json -o src/client/schema.ts",
    "lint": "biome check",
    "lint:fix": "biome check --write"
  },
  "dependencies": {
    "@heroui/react": "3.2.4",
    "@heroui/styles": "3.2.4",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.31",
    "clsx": "2.1.1",
    "react": "^19.2.8",
    "react-aria-components": "1.20.0",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@biomejs/biome": "2.5.9",
    "@playwright/test": "^1.62.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/router-plugin": "^1.168.34",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "babel-plugin-react-compiler": "1.0.0",
    "jsdom": "^30.0.1",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
