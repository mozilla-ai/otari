{
  "name": "@mozilla-ai/otari-dashboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@12.4.0",
  "description": "Otari admin web dashboard (React + HeroUI v3). Builds into src/gateway/static/dashboard so the gateway can serve it.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "typecheck": "tsc -b --noEmit",
    "test": "pnpm run client:generate && vitest run",
    "test:watch": "vitest",
    "e2e": "pnpm run build && playwright test --project=onboarding --project=seed --project=parity --project=parity-webkit",
    "e2e:screenshots": "pnpm run build && playwright test --project=screenshots-desktop-large-light --project=screenshots-desktop-large-dark --project=screenshots-desktop-small-light --project=screenshots-desktop-small-dark --project=screenshots-mobile-light --project=screenshots-mobile-dark",
    "e2e:screenshots:update": "pnpm run e2e:screenshots --update-snapshots=changed",
    "e2e:install": "playwright install chromium webkit",
    "client:generate": "openapi-typescript ../docs/public/openapi.json -o src/client/schema.ts",
    "icons:generate": "node scripts/generate-pwa-icons.mjs",
    "lint": "biome check",
    "lint:fix": "biome check --write"
  },
  "dependencies": {
    "@heroui/react": "3.2.7",
    "@heroui/styles": "3.2.7",
    "@tanstack/react-query": "^5.105.1",
    "@tanstack/react-router": "^1.170.46",
    "canvas-confetti": "^1.9.4",
    "react": "^19.3.1",
    "react-aria-components": "1.22.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "thinking-orbs": "^0.3.2"
  },
  "devDependencies": {
    "@babel/core": "^8.0.10",
    "@biomejs/biome": "2.5.13",
    "@playwright/test": "^1.64.1",
    "@rolldown/plugin-babel": "^0.2.4",
    "@storybook/addon-docs": "10.6.5",
    "@storybook/react-vite": "10.6.5",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/router-plugin": "^1.168.48",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "babel-plugin-react-compiler": "1.0.0",
    "jsdom": "^30.1.3",
    "openapi-typescript": "^7.13.0",
    "storybook": "10.6.5",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
