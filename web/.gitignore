node_modules/
dist/
*.local
.vite/
coverage/
*.tsbuildinfo

# Playwright E2E
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
e2e/e2e.db
e2e/e2e.db-wal
e2e/e2e.db-shm

# Boundary probes: src/architecture.test.ts plants a module under src/<layer>/ to
# prove Biome rejects it, and removes it in the same test. Ignored so a run killed
# mid-test cannot leave one staged.
src/**/__boundary_probe__/

# Screenshot baselines. Not committed while the dashboard is mid-migration: the
# suite runs on demand (see .github/workflows/otari-dashboard.yml), and a
# committed set would churn in every PR that moves a page. Remove this entry in
# the change that turns the suite into a gate, together with the Linux set CI
# captures.
e2e/screenshots/*-snapshots/

# Storybook build output. `node_modules/` above already covers Storybook's cache
# (node_modules/.cache/storybook), so only the build directory needs an entry.
storybook-static/

# Regenerated by .storybook/__shots.mjs.
.storybook/shots/
