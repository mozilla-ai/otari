{
  "openai": {
    "id": "openai",
    "name": "OpenAI",
    "doc": "https://platform.openai.com/docs/models",
    "env": [
      "OPENAI_API_KEY"
    ],
    "models": {
      "gpt-4o": {
        "id": "gpt-4o",
        "type": "chat",
        "name": "GPT-4o",
        "description": "Omni-era GPT for multimodal chat, practical coding, and general assistants",
        "family": "gpt",
        "open_weights": false,
        "knowledge": "2023-09",
        "release_date": "2024-05-13",
        "last_updated": "2024-08-06",
        "modalities": {
          "input": [
            "text",
            "image/jpeg",
            "image/png",
            "image/gif",
            "image/webp",
            "application/pdf"
          ],
          "output": [
            "text"
          ]
        },
        "capabilities": {
          "tools": {
            "supported": true
          },
          "reasoning": {
            "supported": false
          },
          "cache": {
            "implicit": {
              "min_tokens": 1024
            }
          },
          "structured_output": true,
          "temperature": true,
          "system_updates": true,
          "effort_updates": false,
          "store": true,
          "prompt_cache_key": true,
          "service_tier": [
            "priority"
          ]
        },
        "limit": {
          "context": 128000,
          "output": 16384
        },
        "cost": {
          "text": {
            "input": {
              "price": 2.5,
              "cache": {
                "read": 1.25
              }
            },
            "output": {
              "price": 10
            }
          },
          "web_search": {
            "price": 10
          },
          "multipliers": [
            {
              "when": {
                "service_tier": {
                  "equals": "priority"
                }
              },
              "factor": {
                "text": 1.7
              }
            }
          ]
        },
        "api": {
          "responses": {
            "base_url": "https://api.openai.com/v1",
            "sdk": {
              "aisdk": "@ai-sdk/openai",
              "opencodeai": "@opencode/ai/providers/openai/responses"
            },
            "capabilities": {
              "tools": {
                "strict": true,
                "choice": [
                  "auto",
                  "none",
                  "required",
                  "tool"
                ],
                "updates": true
              }
            }
          },
          "chat-completions": {
            "base_url": "https://api.openai.com/v1",
            "sdk": {
              "aisdk": "@ai-sdk/openai",
              "opencodeai": "@opencode/ai/providers/openai/chat"
            },
            "capabilities": {
              "tools": {
                "strict": true,
                "choice": [
                  "auto",
                  "none",
                  "required",
                  "tool"
                ],
                "updates": false
              }
            }
          }
        },
        "experimental": {
          "modes": {
            "fast": {
              "service_tier": "priority",
              "body": {
                "service_tier": "priority"
              }
            }
          }
        }
      },
      "gpt-4": {
        "id": "gpt-4",
