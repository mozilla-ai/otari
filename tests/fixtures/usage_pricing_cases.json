    },
    {
      "name": "the legacy reading prices a token rate on a per-request endpoint per request",
      "rate": {
        "unit": "tokens",
        "input": "2.5",
        "output": "10"
      },
      "tokens": {
        "input": 1000,
        "output": 100
      },
      "units": {
        "requests": 1
      },
      "legacy": true,
      "expected": {
        "cost": "0.000003",
        "meters": {
          "requests": 1
        },
        "lines": [
          {
            "meter": "request",
            "units": 1,
            "unit_rate": 2.5e-06,
            "cost": 3e-06
          }
        ]
      }
    },
    {
      "name": "a token rate on rerank prices the tokens and leaves the search units",
