{
  "description": "What one successful pass-through attempt costs at a rate. Shared by otari's settlement tests and otari.ai's, so both editions are held to one table. Rates are per million: tokens, requests or images. A token rate read the legacy way on image generation is raw USD per image. Every expected cost is worked out by hand from the rate and the counts, not generated from the code. An expected value of null means the rate prices nothing the attempt reported.",
  "cases": [
    {
      "name": "a requests rate bills the requests count",
      "rate": {
        "unit": "requests",
        "input": "2000"
      },
      "tokens": null,
      "units": {
        "requests": 1
      },
      "legacy": false,
      "expected": {
        "cost": "0.002000",
        "meters": {
          "requests": 1
        },
        "lines": [
          {
            "meter": "request",
            "units": 1,
            "unit_rate": 0.002,
            "cost": 0.002
          }
        ]
      }
    },
    {
      "name": "a requests rate bills each search unit",
      "rate": {
        "unit": "requests",
        "input": "2000"
      },
      "tokens": {
        "input": 40,
        "output": 0
      },
      "units": {
        "search_units": 3
      },
      "legacy": false,
      "expected": {
        "cost": "0.006000",
        "meters": {
          "search_units": 3
        },
        "lines": [
          {
            "meter": "search_units",
            "units": 3,
            "unit_rate": 0.002,
            "cost": 0.006
          }
        ]
      }
    },
    {
      "name": "a requests rate bills one request for a completion that reports only tokens",
      "rate": {
        "unit": "requests",
        "input": "5000"
      },
      "tokens": {
        "input": 2000,
        "output": 500
      },
      "units": {},
      "legacy": false,
      "expected": {
        "cost": "0.005000",
        "meters": {
          "requests": 1
        },
        "lines": [
          {
            "meter": "request",
            "units": 1,
            "unit_rate": 0.005,
            "cost": 0.005
          }
        ]
      }
    },
    {
      "name": "a requests rate on embeddings bills one request, not the tokens",
      "rate": {
        "unit": "requests",
        "input": "5000"
      },
      "tokens": {
        "input": 1000,
        "output": 0
      },
      "units": {},
      "legacy": true,
      "expected": {
        "cost": "0.005000",
        "meters": {
          "requests": 1
        },
        "lines": [
          {
            "meter": "request",
            "units": 1,
            "unit_rate": 0.005,
            "cost": 0.005
          }
        ]
      }
    },
    {
      "name": "a requests rate on image generation bills one request, not one rate per image",
      "rate": {
        "unit": "requests",
        "input": "2000"
      },
      "tokens": null,
      "units": {
        "images": 2
      },
      "legacy": true,
      "expected": {
        "cost": "0.002000",
        "meters": {
          "requests": 1
        },
        "lines": [
          {
            "meter": "request",
            "units": 1,
            "unit_rate": 0.002,
            "cost": 0.002
          }
        ]
      }
    },
    {
      "name": "a requests count is preferred over search units and never summed with them",
      "rate": {
        "unit": "requests",
        "input": "2000"
      },
      "tokens": null,
      "units": {
        "requests": 2,
        "search_units": 5
      },
      "legacy": false,
      "expected": {
        "cost": "0.004000",
        "meters": {
          "requests": 2
        },
        "lines": [
          {
            "meter": "request",
            "units": 2,
            "unit_rate": 0.002,
            "cost": 0.004
          }
        ]
      }
    },
    {
      "name": "zero requests cost nothing and carry no meter",
      "rate": {
        "unit": "requests",
        "input": "2000"
      },
      "tokens": null,
      "units": {
        "requests": 0
      },
      "legacy": false,
      "expected": {
        "cost": "0.000000",
        "meters": {},
        "lines": []
      }
    },
    {
      "name": "a free requests rate costs nothing and carries no meter",
      "rate": {
        "unit": "requests",
        "input": "0"
      },
      "tokens": null,
      "units": {
        "requests": 1
      },
      "legacy": false,
      "expected": {
        "cost": "0.000000",
        "meters": {},
        "lines": []
      }
    },
    {
      "name": "a per-request price under half a micro-dollar rounds a single request to nothing",
      "rate": {
        "unit": "requests",
        "input": "0.4"
      },
      "tokens": null,
      "units": {
        "requests": 1
      },
      "legacy": false,
      "expected": {
        "cost": "0.000000",
        "meters": {},
        "lines": []
      }
    },
    {
      "name": "sub-micro-dollar requests are summed before rounding",
      "rate": {
        "unit": "requests",
        "input": "0.4"
      },
      "tokens": null,
      "units": {
        "requests": 3
      },
      "legacy": false,
      "expected": {
        "cost": "0.000001",
        "meters": {
          "requests": 3
        },
        "lines": [
          {
            "meter": "request",
            "units": 3,
            "unit_rate": 4e-07,
            "cost": 1e-06
          }
        ]
      }
    },
    {
      "name": "an unknown meter is ignored",
      "rate": {
        "unit": "requests",
        "input": "2000"
      },
      "tokens": null,
      "units": {
        "seconds": 30
      },
      "legacy": false,
      "expected": {
        "cost": "0.002000",
        "meters": {
          "requests": 1
        },
        "lines": [
          {
            "meter": "request",
            "units": 1,
            "unit_rate": 0.002,
            "cost": 0.002
          }
        ]
      }
    },
    {
