      "expected": null
    },
    {
      "name": "an images rate prices nothing on an endpoint billed per request",
      "rate": {
        "unit": "images",
        "input": "40000"
      },
      "tokens": null,
      "units": {
        "requests": 1
      },
      "legacy": true,
      "expected": null
    },
    {
      "name": "a token rate prices a token-billed image on its tokens, never at the rate per image",
      "rate": {
        "unit": "tokens",
