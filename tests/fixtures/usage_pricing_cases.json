      },
      "tokens": {
        "input": 50,
        "output": 4160
      },
      "units": {
        "images": 1
      },
      "legacy": false,
      "expected": {
        "cost": "0.166650"
      }
    },
    {
      "name": "a token rate prices nothing for an image that reported no tokens",
      "rate": {
        "unit": "tokens",
        "input": "5",
        "output": "40"
      },
      "tokens": null,
      "units": {
        "images": 1
      },
      "legacy": false,
      "expected": null
    },
    {
