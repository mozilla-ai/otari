      }
    },
    {
      "name": "an images rate bills the largest count one attempt may report",
      "rate": {
        "unit": "images",
        "input": "40000"
      },
      "tokens": null,
      "units": {
        "images": 1000000
      },
      "legacy": false,
      "expected": {
        "cost": "40000.000000",
        "meters": {
          "images": 1000000
        },
        "lines": [
          {
            "meter": "images",
            "units": 1000000,
            "unit_rate": 0.04,
            "cost": 40000.0
          }
        ]
      }
    },
    {
      "name": "no images returned cost nothing",
      "rate": {
        "unit": "images",
        "input": "40000"
      },
      "tokens": null,
      "units": {
        "images": 0
      },
