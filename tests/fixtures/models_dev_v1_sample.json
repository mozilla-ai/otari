        "family": "claude-sonnet",
        "attachment": true,
        "reasoning": true,
        "reasoning_options": [
          {
            "type": "budget_tokens",
            "min": 1024
          }
        ],
        "tool_call": true,
        "structured_output": true,
        "temperature": true,
        "knowledge": "2025-07-31",
        "release_date": "2025-09-29",
        "last_updated": "2025-09-29",
        "modalities": {
          "input": [
            "text",
