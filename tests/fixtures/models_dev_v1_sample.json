  "anthropic": {
    "id": "anthropic",
    "env": [
      "ANTHROPIC_API_KEY"
    ],
    "npm": "@ai-sdk/anthropic",
    "name": "Anthropic",
    "doc": "https://docs.anthropic.com/en/docs/about-claude/models",
    "models": {
      "claude-sonnet-4-5": {
        "id": "claude-sonnet-4-5",
        "name": "Claude Sonnet 4.5 (latest)",
